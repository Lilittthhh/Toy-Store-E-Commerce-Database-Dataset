PGHOST=localhost
PGPORT=5432
PGDATABASE=retailmetrics
PGUSER=postgres
PGPASSWORD=replace_with_your_local_password
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10

# Generate a private value of at least 32 characters for local use.
JWT_SECRET_KEY=replace_with_a_long_random_local_secret
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RESET_TOKEN_MINUTES=15

# Optional local mock-mode development only. It is ignored for token exposure
# whenever NOTIFICATION_MODE is live. Keep false otherwise.
AUTH_EXPOSE_RESET_TOKEN=false
AUDIT_TRAIL_ENABLED=false

# Notification delivery is always simulated unless explicitly configured otherwise.
NOTIFICATION_MODE=mock
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=RetailMetrics
# Separate explicit gates. Keep both false in automated tests.
SMTP_LIVE_SEND_ENABLED=false
SMS_PROVIDER=brevo
BREVO_API_KEY=
# Brevo may require an approved alphanumeric sender of at most 11 characters.
BREVO_SMS_SENDER=RetailMetrics
BREVO_SMS_LIVE_SEND_ENABLED=false


# Streamlit-to-FastAPI HTTP endpoint. Replace HOST_IP with this computer's
# Wi-Fi/LAN IPv4 address from ipconfig (for example, 192.168.1.25).
# The combined launcher also resolves this placeholder automatically.
API_BASE_URL=http://HOST_IP:8000

# Optional non-interactive initial-Admin bootstrap inputs. Interactive input is
# safer for the password, so do not normally save BOOTSTRAP_ADMIN_PASSWORD here.
# BOOTSTRAP_ADMIN_USERNAME=initial_admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_only_for_controlled_automation
