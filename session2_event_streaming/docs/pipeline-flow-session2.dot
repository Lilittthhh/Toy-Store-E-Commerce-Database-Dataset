
digraph Pipeline {
  rankdir=LR;
  bgcolor="white";
  fontname="Helvetica";
  labelloc="t";
  fontsize=17;
  label=<<b>RetailMetrics — Session 2 Run-Everything Flow</b><br/>
  <font point-size="11">presentation order with valid pre- and post-produce guarantees</font><br/>>;

  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10 width=2.0 height=0.8];
  edge [color="#2E74B5" penwidth=1.6];

  pre [label="1. Log self-test
PRE-PRODUCE
config • routing • readiness" fillcolor="#FFF2CC"];
  prod [label="2. Produce
1,188,124 pageviews +
1,731 refunds" fillcolor="#E2EFDA"];
  post [label="automatic post-produce
log guarantees
ordering • replay • retention" fillcolor="#FFF2CC"];
  con [label="3. Consume
3 independent groups
+ offsets/lag" fillcolor="#E2EFDA"];
  rec [label="4. Reconcile
stream = Session 1 batch" fillcolor="#FCE4D6"];
  fail [label="5. Failure & recovery
at-least-once + idempotency" fillcolor="#FCE4D6"];
  rep [label="6. Replay
late join • rewind • partial" fillcolor="#D9EAF7"];

  pre -> prod -> post -> con -> rec -> fail -> rep;
}
